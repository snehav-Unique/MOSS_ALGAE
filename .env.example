# Browser-visible backend origin for separately hosted frontend/backend deployments.
# Leave empty on Vercel when vercel.json routes /api to the backend service.
NEXT_PUBLIC_API_URL=

# Local Next.js development proxy target. The default is http://127.0.0.1:8000.
BACKEND_URL=http://127.0.0.1:8000

# Browser-visible Firebase web configuration. These identify the Firebase
# project but do not replace Firestore Security Rules or server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Planning assistant (backend only, never exposed to the browser).
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override; default is gemini-3.5-flash-lite.
GEMINI_MODEL=

# Server-only OpenAQ access. Never prefix this with NEXT_PUBLIC_.
OPENAQ_API_KEY=

# Optional: pin specific OpenAQ location IDs as a comma-separated list.
# When omitted, the backend discovers stations within the configured radius.
OPENAQ_LOCATION_IDS=
OPENAQ_LATITUDE=12.9716
OPENAQ_LONGITUDE=77.5946
OPENAQ_RADIUS_METERS=25000

# Firebase Admin / Firestore storage for citizen pod suggestions.
# Use literal \n sequences inside FIREBASE_PRIVATE_KEY when stored on one line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required to read suggestions at /owner-feedback. Use a long random value.
# This remains server-side; owners enter it into the unlinked dashboard.
OWNER_DASHBOARD_KEY=

# Standalone owner feedback viewer (runs independently on port 3001).
OWNER_DASHBOARD_PORT=3001
OWNER_API_URL=http://127.0.0.1:8001

# Live sensor relay: the laptop wired to the ESP32 forwards readings to the deployed app.
# Set the same random SENSOR_RELAY_KEY on Vercel (backend) and in this laptop's .env.
SENSOR_RELAY_KEY=
# Laptop only: the deployed app URL the relay sends to.
RELAY_TARGET_URL=
